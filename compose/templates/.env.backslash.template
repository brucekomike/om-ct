# Backslash self-hosted LaTeX editor
PORT=3000
WS_PORT=3001
SESSION_SECRET=$(generate_token)$(generate_token)

POSTGRES_DB=backslash
POSTGRES_USER=backslash
POSTGRES_PASSWORD=backslash
DATABASE_URL=postgresql://backslash:backslash@backslash-db:5432/backslash
REDIS_URL=redis://backslash-redis:6379

STORAGE_PATH=/data/backslash
PROJECTS_VOLUME=backslash-project-data
COMPILER_IMAGE=backslash-compiler
COMPILE_MEMORY=1g
COMPILE_CPUS=1.5
MAX_CONCURRENT_BUILDS=5
COMPILE_TIMEOUT=120
STALE_BUILD_TTL_MINUTES=60
RUN_COMPILE_RUNNER_IN_WEB=false
WORKER_HEARTBEAT_KEY=compile:worker:heartbeat
WORKER_HEARTBEAT_MAX_AGE_MS=30000
WORKER_HEARTBEAT_INTERVAL_MS=5000
ASYNC_COMPILE_RESULT_TTL_MINUTES=60
ASYNC_COMPILE_MAX_CONCURRENT_BUILDS=5
MIGRATE_MAX_ATTEMPTS=30
MIGRATE_RETRY_DELAY_SECONDS=2

DISABLE_SIGNUP=false
SECURE_COOKIES=true
APP_URL=https://$BACKSLASHURL
WS_PATH_PREFIX=/ws
CORS_ORIGIN=https://$BACKSLASHURL

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_AI_API_KEY=
