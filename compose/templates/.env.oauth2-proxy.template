# Local-only defaults: create a Casdoor OIDC app with this client ID and secret.
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_PROVIDER_DISPLAY_NAME=Casdoor
OAUTH2_PROXY_OIDC_ISSUER_URL=http://$CASDOORURL:8000
OAUTH2_PROXY_CLIENT_ID=rustpad-local
OAUTH2_PROXY_CLIENT_SECRET=local-only-client-secret
OAUTH2_PROXY_REDIRECT_URL=http://$OAUTH2URL:4180/oauth2/callback
OAUTH2_PROXY_COOKIE_SECRET=$(generate_token)
OAUTH2_PROXY_COOKIE_DOMAINS=.$MURL
OAUTH2_PROXY_WHITELIST_DOMAINS=.$MURL
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_SCOPE=openid email profile
OAUTH2_PROXY_CODE_CHALLENGE_METHOD=S256
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_UPSTREAMS=http://rustpad:3030/
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
OAUTH2_PROXY_COOKIE_SECURE=false
OAUTH2_PROXY_COOKIE_SAMESITE=lax

https_proxy=
http_proxy=
HTTP_PROXY=
HTTPS_PROXY=
